# --- Основное ---
PORT=3000
# Номер WhatsApp менеджера в международном формате, только цифры
WHATSAPP_PHONE=77010000000
# Валюта и минимальная сумма заказа (0 = без ограничения)
CURRENCY=₸
MIN_ORDER_AMOUNT=5000

# --- Админ-панель (/admin.html) ---
# Обязательно смените перед публикацией
ADMIN_TOKEN=change-me

# --- Google Sheets как источник каталога (опционально) ---
# Файл -> Поделиться -> Опубликовать в интернете -> лист -> формат CSV
CATALOG_SHEET_CSV_URL=
# Период автосинхронизации каталога из Sheets, мс (0 = только вручную)
CATALOG_SYNC_INTERVAL_MS=300000

# --- Дублирование заказов в Google Sheets (опционально) ---
# URL веб-приложения Google Apps Script, принимающего POST с JSON заказа
ORDERS_WEBHOOK_URL=
